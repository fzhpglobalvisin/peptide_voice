# ── Gemini (server-side only; never exposed to the browser) ─────────────
GEMINI_API_KEY=
# Live model for voice. Check https://ai.google.dev/gemini-api/docs/models for the current Live model id.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Text model used to summarise closed sessions.
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Prebuilt voice name (Puck, Kore, Charon, Aoede, ...)
GEMINI_VOICE=Puck
# Max voice sessions a single IP may start per hour (protects prepaid credits)
LIVE_SESSIONS_PER_IP_PER_HOUR=12

# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://app.ridgelinefit.com
# Store WhatsApp number in international format, digits only (quotes are sent here by the customer)
# Store's real WhatsApp number: country code + number, digits only (e.g. Pakistan 923001234567, US 13055551234)
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=

# ── Database: PostgreSQL (free: Neon via Vercel → Storage → Create Database → Neon) ──
# Vercel's Neon integration sets DATABASE_URL automatically. For local dev: vercel env pull .env.local
# or paste the connection string from the Neon dashboard (the "pooled" one ending in -pooler is best).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Time zone for the dashboard's daily/monthly charts (IANA name, e.g. Asia/Karachi, America/New_York)
STORE_TIMEZONE=UTC

# ── Optional: WhatsApp Cloud API (sends the quote link to the customer after opt-in)
# Requires an approved template with two body variables: {{1}} customer name, {{2}} quote URL.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=research_quote_ready
WHATSAPP_TEMPLATE_LANG=en_US

# ── Admin login (username + password) ───────────────────────────────────
# Used ONCE to create the first admin account in the database. After that, change the
# username, email and password in /admin/account (editing these lines has no effect).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password
# Recovery email for "Forgot username or password"
ADMIN_EMAIL=you@example.com
# Optional instead of ADMIN_PASSWORD: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=
# Signs the login cookie. Any long random string (32+ characters).
AUTH_SECRET=

# ── Email (for password reset). Gmail: turn on 2-Step Verification, create an App Password.
# Leave empty during development: reset emails are printed in the terminal instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ridgeline Admin <you@example.com>

# ── Social profiles (header/footer icons). Defaults are the live site's profiles.
NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/ridgelinefit01
NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/ridgelinefit1/
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_X=https://x.com/Ridgelinefit1

# ── Desktop / Tablet / Mobile view switcher: shown in development and to signed-in admins.
# on = show to every visitor, off = never show
NEXT_PUBLIC_DEVICE_PREVIEW=

# ── Admin login page extras
# Lets people create an admin account on the login page ("Create account" tab). Leave empty to turn it off.
ADMIN_INVITE_CODE=
# Quick-pick admin user-ID chips on the login page: shown in development; on = show on the live site too, off = never
ADMIN_SHOW_ACCOUNTS=
